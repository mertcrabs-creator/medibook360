# Copy with `pnpm setup:env` - it fills every secret with a random value.
# Never commit the real .env file.

NODE_ENV=development

# --- Docker services (docker-compose.yml) ---
POSTGRES_DB=medibook
POSTGRES_USER=medibook
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_PORT=5432
VALKEY_PASSWORD=__GENERATE__
VALKEY_PORT=6379

# --- API (apps/api) ---
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://medibook:${POSTGRES_PASSWORD}@localhost:5432/medibook?schema=public
VALKEY_URL=redis://:${VALKEY_PASSWORD}@localhost:6379
SMTP_HOST=localhost
SMTP_PORT=1025
TRUST_PROXY=loopback
# Encrypts TOTP (2FA) secrets at rest. Losing it disables every authenticator.
TOTP_ENCRYPTION_KEY=__GENERATE__

# --- Web (apps/web) ---
# Where the Next.js server forwards /api/* requests.
API_INTERNAL_URL=http://127.0.0.1:4000
